# Application
APP_NAME="NextStep AI Interview Server"
DEBUG=true

# Supabase PostgreSQL. Never commit the real password.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require"

# Independent LLM providers
GROQ_API_KEY="paste_groq_api_key_here"
CLOUDFLARE_ACCOUNT_ID="paste_cloudflare_account_id_here"
CLOUDFLARE_API_TOKEN="paste_cloudflare_workers_ai_token_here"
INCEPTION_API_KEY="paste_inception_api_key_here"
OPENTYPHOON_API_KEY="paste_opentyphoon_api_key_here"
OLLAMA_API_KEY="paste_ollama_cloud_api_key_here"
NVIDIA_API_KEY="paste_nvidia_api_key_here"

# One model family per provider
GROQ_MODEL="openai/gpt-oss-120b"
CLOUDFLARE_MODEL="@cf/qwen/qwen3-30b-a3b-fp8"
INCEPTION_MODEL="mercury-2.5"
OPENTYPHOON_MODEL="typhoon-v2.5-30b-a3b-instruct"
OLLAMA_CLOUD_MODEL="gemma4:31b"
NVIDIA_NEMOTRON_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# Optional soft stop per provider. Zero means rely on provider quota responses.
DATASET_PROVIDER_TOKEN_BUDGET=0

# Existing application options
GEMINI_API_KEY="paste_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
CV_AI_ENRICHMENT_ENABLED=true
RESEARCH_PSEUDONYM_SALT="replace_with_a_random_private_value"
JWT_ACCESS_SECRET="replace_with_a_random_private_value"
JWT_ACCESS_EXPIRES_IN="15m"
